# Supabase (use DEV project credentials for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — bypasses RLS. Server-side ONLY. Used by the /platform
# admin pages to read ai_calls across all orgs and run admin auth operations
# (e.g. deleting bot accounts). Get from Supabase dashboard → Project settings
# → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (for AI-powered SOP generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Site URL (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (for sending invite emails)
RESEND_API_KEY=your-resend-api-key

# Cloudflare Turnstile (bot protection on auth forms)
# 1) Create a site at https://dash.cloudflare.com → Turnstile
# 2) Paste the site key below (public, safe to ship)
# 3) Paste the secret key into Supabase dashboard → Auth → Settings →
#    Bot and Abuse Protection → enable, provider "Turnstile"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (production only — leave empty in dev)
# Get this from https://analytics.google.com → Admin → Data streams
NEXT_PUBLIC_GA_ID=

# GA Data API — for the founder /insights dashboard
# 1) Create a GCP service account with the "Viewer" role on your GA property
# 2) Download the JSON key, paste client_email and private_key below
# 3) GA_PROPERTY_ID is the numeric ID (NOT the G-XXX measurement ID) — find it
#    in GA Admin → Property settings → Property ID
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=

# Founder allowlist — comma-separated emails that can access /insights.
# Leave empty to disable the dashboard entirely.
FOUNDER_EMAILS=radu.cimpian94@gmail.com
