# Supabase (use DEV project credentials for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (for AI-powered SOP generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Site URL (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (for sending invite emails)
RESEND_API_KEY=your-resend-api-key

# Google Analytics 4 measurement ID (production only — leave empty in dev)
# Get this from https://analytics.google.com → Admin → Data streams
NEXT_PUBLIC_GA_ID=

# GA Data API — for the founder /insights dashboard
# 1) Create a GCP service account with the "Viewer" role on your GA property
# 2) Download the JSON key, paste client_email and private_key below
# 3) GA_PROPERTY_ID is the numeric ID (NOT the G-XXX measurement ID) — find it
#    in GA Admin → Property settings → Property ID
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=

# Founder allowlist — comma-separated emails that can access /insights.
# Leave empty to disable the dashboard entirely.
FOUNDER_EMAILS=radu.cimpian94@gmail.com
